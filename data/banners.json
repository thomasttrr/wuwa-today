      "startsAt": "2026-11-12T10:00:00+08:00",
      "endsAt": "2026-12-21T11:59:00+08:00",
      "note": "Pick one of the four as your rate-up. You can change your pick at any time. The 50/50 still applies \u2014 lose it and you get a standard 5-star instead. Pity and your guarantee are shared only with other Reverb Resonator convenes. They do not carry over to the featured banners.",
      "pool": [
        {
          "name": "Phoebe",
          "pickIf": "you own Zani",
          "reason": "She piles Spectro Frazzle stacks onto enemies, and Zani cashes them in for big damage \u2014 that pair is a finished team core. Without Zani she is a niche pick. With Zani, she is the reason to open this banner."
        },
        {
          "name": "Brant",
          "pickIf": "you own Lupa",
          "reason": "He powers Lupa's Fusion team: she lowers enemy Fusion resistance and buffs Fusion damage, and he brings damage, healing and shields. His best build wants his signature weapon \u2014 that is what Tideforge is for."
        },
        {
          "name": "Camellya",
          "pickIf": "you need a Havoc carry",
          "reason": "A real Havoc main DPS who works with Sanhua, who is free. Newer carries have overtaken her, so pick her for her playstyle, or as a second Havoc team for Tower and Wastes \u2014 not for raw power."
        },
        {
          "name": "Roccia",
          "pickIf": "you own Camellya",
          "reason": "Camellya's best support: she buffs Havoc damage and pulls enemies together in one slot. Without Camellya she has no team \u2014 Sanhua covers everyone else for free."
        }
      ],
      "sources": [
        "https://game8.co/games/Wuthering-Waves/archives/606968",
        "https://game8.co/games/Wuthering-Waves/archives/453303",
        "https://www.facebook.com/WutheringWaves.Official/posts/pfbid033dfgrb74zTR4VdNmWQ8uJKaPkmY7tNnAdcfuoiyA88NTYmGgmiZDp8ACyfuewZ3vl"
      ]
    },
    {
      "id": "tideforge-reverbs-ii",
      "name": "Tideforge Reverbs II",
      "kind": "weapon",
      "conveneLabel": "Reverb Weapon Convene",
      "startsAt": "2026-11-12T10:00:00+08:00",
      "endsAt": "2026-12-21T11:59:00+08:00",
      "note": "Pick one of the four as your target. You can change your pick at any time. Pity is shared only with other Reverb Weapon convenes.",
      "rule": "No 50/50 on weapons: the weapon you pick is guaranteed within 80 pulls. Only pull the one that matches a character you own. Each one is that character's best weapon, and only a small upgrade for anyone else.",
      "pool": [
        {
          "name": "Red Spring",
          "forCharacter": "Camellya",
          "pickIf": "you run Camellya",
          "reason": "Her signature sword and her biggest single upgrade \u2014 its buffs feed the Basic Attack damage her whole kit is built on, and no standard sword comes close for her. It is a one-character weapon, though: without Camellya, leave it."
        },
        {
          "name": "Tragicomedy",
          "forCharacter": "Roccia",
          "pickIf": "you run Roccia alongside Camellya",
          "reason": "Roccia\u2019s signature gauntlets, giving her the Crit Rate and Heavy Attack damage her support kit wants. The narrowest pick of the four \u2014 Roccia\u2019s only real team is Camellya\u2019s, so this only pays off if you run that pair."
        },
        {
          "name": "Luminous Hymn",
          "forCharacter": "Phoebe",
          "pickIf": "you run Phoebe \u2014 mainly with Zani",
          "reason": "Phoebe\u2019s signature rectifier, tuned for her Spectro Frazzle stacking, with extra damage against Frazzle-marked enemies. Its value rises and falls with the Zani pairing: a finished team core with her, a niche pick without."
        },
        {
          "name": "Unflickering Valor",
          "forCharacter": "Brant",
          "pickIf": "you run Brant",
          "reason": "The one signature here that changes the build \u2014 Brant's damage scales with Energy Regen, and this sword's huge Energy Regen bonus is how his best setup reaches it. If Brant anchors your Lupa team, this is the strongest pick of the four."
